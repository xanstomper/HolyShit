# HolyShit! — environment configuration
# Copy to .env or export these in your shell

# Required: endpoint for any operator-controlled OpenAI-compatible server
HOLYSHIT_ENDPOINT=http://localhost:8080/v1

# Optional: API key if the endpoint requires auth
# HOLYSHIT_API_KEY=sk-your-key-here

# Required: comma-separated model list for consensus mode, single for chain/single
HOLYSHIT_MODELS=model-a,model-b

# Optional: engagement target context (prepended to system prompt)
# HOLYSHIT_TARGET=example.com
